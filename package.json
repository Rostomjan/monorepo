{
  "name": "monorepo-root",
  "version": "0.0.0",
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint-config-next": "15.0.4",
    "eslint-config-turbo": "^2.11.9",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-turbo": "^2.11.9",
    "husky": "^9.1.7",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "syncpack": "^15.3.3",
    "tailwindcss": "4.3.3",
    "turbo": "2.11.9"
  },
  "lint-staged": {
    "*.{js,ts,tsx,md,json}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.4.3",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "turbo run lint type-check build && turbo run test --filter='!e2e' && bun run test:scripts",
    "clean": "turbo run clean 2>/dev/null; rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.next apps/*/.expo",
    "deps:fix": "bunx syncpack fix && bunx syncpack format",
    "deps:lint": "bunx syncpack lint",
    "dev": "turbo dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "knip": "bunx knip --exclude unlisted,unresolved --no-config-hints",
    "lint": "turbo lint",
    "new": "bun scripts/scaffold.ts",
    "prepare": "husky",
    "test": "bun test scripts && turbo test --filter='!e2e'",
    "test:e2e": "turbo test --filter=e2e",
    "type-check": "turbo type-check",
    "update": "bunx npm-check-updates -u --workspaces --root --reject eslint,eslint-config-next,eslint-plugin-react-hooks,storybook,@storybook/* && bun install",
    "update:check": "bunx npm-check-updates --workspaces --root --reject eslint,eslint-config-next,eslint-plugin-react-hooks,storybook,@storybook/*"
  },
  "syncpack": {
    "versionGroups": [
      {
        "label": "local workspace packages use workspace:*",
        "packages": [
          "**"
        ],
        "dependencies": [
          "@repo/*"
        ],
        "dependencyTypes": [
          "dev",
          "peer",
          "prod"
        ],
        "pinVersion": "workspace:*"
      },
      {
        "label": "eslint 8 era: react-hooks stays on v5 (v6+ needs flat config)",
        "packages": [
          "**"
        ],
        "dependencies": [
          "eslint-plugin-react-hooks"
        ],
        "pinVersion": "5.1.0"
      },
      {
        "label": "eslint 8 era: eslint-config-next stays on v15 (v16 needs flat config)",
        "packages": [
          "**"
        ],
        "dependencies": [
          "eslint-config-next"
        ],
        "pinVersion": "15.0.4"
      },
      {
        "label": "eslint 8 era: eslint stays on v8 (v9+ needs flat config)",
        "packages": [
          "**"
        ],
        "dependencies": [
          "eslint"
        ],
        "dependencyTypes": [
          "dev",
          "peer",
          "prod"
        ],
        "pinVersion": "^8.57.0"
      },
      {
        "label": "storybook 8 era: v10 breaks Icons export (monorepo-ui)",
        "packages": [
          "**"
        ],
        "dependencies": [
          "storybook",
          "@storybook/*"
        ],
        "dependencyTypes": [
          "dev"
        ],
        "pinVersion": "8.5.8"
      }
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
