{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CONVEX_URL", "CONVEX_DEPLOYMENT", "NEXT_PUBLIC_CONVEX_URL", "NEXT_PUBLIC_API_URL", "API_URL", "NODE_ENV", "PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "convex/**", "public/**", "package.json", "tsconfig*.json", "next.config.*", "tailwind.config.*", "postcss.config.*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "convex/**", "**/*.ts", "**/*.tsx", "tsconfig.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "**/*.test.*", "package.json", "tsconfig.json"]
    },
    "check": {
      "dependsOn": ["lint", "type-check", "test", "build"]
    }
  }
}
