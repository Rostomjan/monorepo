{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CONVEX_URL", "CONVEX_DEPLOYMENT", "NEXT_PUBLIC_CONVEX_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
